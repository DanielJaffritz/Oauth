// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
namespace public {
model User {
    id String @id @default(uuid())
    name String
    email String @unique
    password String?
    salt String?
    role pg.enum(Role) @default("USER")
    createdAt DateString @default(now())
    useroauthaccounts UserOauthAccount[]
  }
model UserOauthAccount {
    userId String
    providerAccountId String @unique
    provider pg.enum(OAuthProvider)
    createdAt DateString @default(now())
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  }
native_enum Role {
    USER = "USER"
    ADMIN = "ADMIN"
  }
native_enum OAuthProvider {
    GITHUB = "GITHUB"
    DISCORD = "DISCORD"
  }
}
